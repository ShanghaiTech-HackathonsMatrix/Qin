# 开发环境 CSP：需要 ws: 支持 Vite HMR，需要 'unsafe-inline' 支持 React Refresh preamble
# 'wasm-unsafe-eval' 只放开 WebAssembly 编译（sql.js 的 SQLite 引擎），不等于放开 JS 的 eval
VITE_CSP=default-src 'none'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ws: wss:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none';
