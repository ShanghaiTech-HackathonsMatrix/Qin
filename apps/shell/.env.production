# 生产环境 CSP：connect-src 'none'
# 依赖：CapacitorHttp 保持关闭（架构不变量 I7）
# 'wasm-unsafe-eval' 只放开 WebAssembly 编译（sql.js 的 SQLite 引擎），不等于放开 JS 的 eval
VITE_CSP=default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none';
