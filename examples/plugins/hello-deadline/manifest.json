{
  "id": "org.example.hello-deadline",
  "name": "示例提醒事项",
  "version": "1.0.0",
  "apiVersion": "^1.0.0",
  "kind": "logic",
  "entry": "bundle.js",
  "permissions": {"data": {"write": ["notice"], "read": ["notice"]}, "ui": {"slots": ["app.matrix.timeline.event"]}},
  "contributes": {
    "entityTypes": [{"name": "notice", "schema": {"type": "object", "properties": {"title": {"type": "string", "maxLength": 200}, "at": {"type": "number"}}, "required": ["title", "at"], "additionalProperties": false}}],
    "views": [{"id": "summary", "title": "示例提醒事项", "kind": "widget", "requires": ["notice"]}],
    "consumesSlots": [{"slot": "app.matrix.timeline.event", "from": "notice", "map": {"title": "title", "startAt": "at"}}]
  }
}
